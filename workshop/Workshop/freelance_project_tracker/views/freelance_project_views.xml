<odoo>
    <record id="freelance_project_action" model="ir.actions.act_window">
        <field name="name">Freelance Projects</field>
        <field name="res_model">freelance.project</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="freelance_project_view_list" model="ir.ui.view">
        <field name="name">freelance.project.list</field>
        <field name="model">freelance.project</field>
        <field name="arch" type="xml">
            <list>
               <field name = 'name'/>
               <field name = 'client_id'/> 
               <field name = 'price'/>
               <field name = 'state'/>
            </list>
        </field>
    </record>

    <record id="freelance_project_view_form" model="ir.ui.view">
        <field name="name">freelance.project.form</field>
        <field name="model">freelance.project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name = 'claim_project' type = 'object' string = 'Claim Project' invisible = "state in ('progress', 'completed')"/>
                    <button name = 'complete_project' type = 'object' string = 'Complete Project' invisible = "state in ('open', 'completed')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                   <h1>
                    <field name = 'name'/>
                   </h1>
                   <group>
                    <field name = 'description'/>
                    <field name = 'price'/>
                   </group>
                   <group>
                    <field name = 'category_id'/>
                    <field name = 'client_id'/>
                    <field name = 'freelancer_id'/>
                   </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="freelance_project_view_kanban" model="ir.ui.view">
        <field name="name">freelance.project.kanban</field>
        <field name="model">freelance.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by = 'category_id'>
               <templates>
                <t t-name = 'card'>
                    <field name = 'name'/>
                    <field name = 'description'/>
                    <field name = 'client_id'/>
                    <field name = 'price'/>
                </t>
               </templates>
            </kanban>
        </field>
    </record>

</odoo>